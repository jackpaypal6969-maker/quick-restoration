# ── Quick Restoration ─ environment ─────────────────────────────────────────
# Copy to .env.local (dev) or .env.production (VPS). Never commit real values.

# Public site URL (no trailing slash). Used for canonical URLs, sitemap, OG tags.
NEXT_PUBLIC_SITE_URL=https://quickrestorationny.com

# Where contact-form leads are emailed. Comma-separate for multiple recipients.
CONTACT_TO_EMAIL=office@quickrestorationny.com
# "From" identity for outgoing lead emails (must be a verified sender/domain).
CONTACT_FROM_EMAIL=Quick Restoration Website <no-reply@quickrestorationny.com>

# ── Email delivery: configure ONE of the two providers below ────────────────
# Option A — Resend (https://resend.com). Simplest; verify your domain first.
RESEND_API_KEY=

# Option B — Any SMTP relay (Google Workspace, Microsoft 365, Postmark, SES…)
SMTP_HOST=
SMTP_PORT=587
# false = STARTTLS on 587 (required; no plaintext fallback), true = implicit TLS on 465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── Optional ────────────────────────────────────────────────────────────────
# Directory where every lead is also appended as JSON lines (backup copy).
LEADS_DIR=./data
# Port the Node server listens on behind Nginx.
PORT=3010
